# Supabase project banane ke baad ye values yahan daalo
# Dashboard > Project Settings > API se mil jayengi

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# App ka apna URL (local me ye rehne do, production me apna domain daalna)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side Supabase access (publish/revoke ke liye chahiye)
# Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Cron scheduler authorization (Vercel Cron ke liye chahiye)
# Vercel Dashboard > Settings > Environment Variables me CRON_SECRET set karo
CRON_SECRET=

# OpenAI API key (AI caption generation ke liye — optional)
# https://platform.openai.com/api-keys se milega
OPENAI_API_KEY=

# --- Twitter/X ---
# https://developer.twitter.com se milega
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- LinkedIn ---
# https://www.linkedin.com/developers/apps se milega
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Facebook / Instagram / Threads ---
# https://developers.facebook.com se milega (Instagram bhi isi se connect hota hai)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- TikTok ---
# https://developers.tiktok.com se milega
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- YouTube (Google OAuth) ---
# https://console.cloud.google.com se milega
# YouTube Data API v3 enable karna zaroori hai
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Pinterest ---
# https://developers.pinterest.com se milega
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# --- Reddit ---
# https://www.reddit.com/prefs/apps se milega
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Mastodon ---
# Apne instance ke /settings/applications par client ID/secret generate karo
# Ye global credentials hain — sab Mastodon instances par kaam karenge
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=

# --- Bluesky ---
# Bluesky app passwords use karta hai (OAuth nahi)
# User Bluesky settings > App passwords se generate karta hai
# Koi server-side credentials nahi chahiye

# --- Google Business Profile ---
# Google OAuth credentials (same as YouTube)
# Google My Business API enable karna zaroori hai

# --- WhatsApp Business ---
# Meta Business Dashboard se permanent token chahiye
# https://business.facebook.com se milega
WHATSAPP_BUSINESS_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
